<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <!-- Hyva theme: swap the Luma per-method paymentinfo templates for the shared
             TokenBaseHyvaCheckout ones, and attach the eCheck payment pane. -->
        <referenceBlock name="tokenbase_manage_authnetcim_ach" template="ParadoxLabs_TokenBaseHyvaCheckout::customer/method.phtml"/>
        <referenceBlock name="tokenbase_manage_authnetcim_ach_cards" template="ParadoxLabs_TokenBaseHyvaCheckout::customer/cards.phtml"/>
        <!-- The Luma form block (Authnetcim Block\Customer\Form\Ach) swaps its own template in _toHtml
             when form_type is Accept Hosted, which would stomp a layout retemplate; replace it with
             the plain TokenBase form block driving the shared Hyva scaffold instead. -->
        <referenceBlock name="tokenbase_manage_authnetcim_ach_form" remove="true"/>
        <referenceBlock name="tokenbase_manage_authnetcim_ach">
            <block class="ParadoxLabs\TokenBase\Block\Customer\Form" name="tokenbase_manage_authnetcim_ach_form_hyva" as="tokenbase_customer_method_right" template="ParadoxLabs_TokenBaseHyvaCheckout::customer/form.phtml">
                <arguments>
                    <argument name="form_title" xsi:type="string">Add A Bank Account (eCheck)</argument>
                </arguments>
                <block class="ParadoxLabs\TokenBase\Block\Customer\Form" name="tokenbase_manage_authnetcim_ach_form_pane" as="payment_pane" template="ParadoxLabs_AuthnetcimHyvaCheckout::customer/form/ach.phtml"/>
            </block>
        </referenceBlock>
    </body>
</page>
