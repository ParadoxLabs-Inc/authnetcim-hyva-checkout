use Hyva\Theme\Model\ViewModelRegistry;
use Magento\Framework\Escaper;
use Magento\Framework\View\Element\Template;
use ParadoxLabs\AuthnetcimHyvaCheckout\Magewire\Payment\AuthnetcimWallet;
use ParadoxLabs\AuthnetcimHyvaCheckout\ViewModel\WalletConfig;

/** @var Template $block */
/** @var AuthnetcimWallet $magewire */
/** @var Escaper $escaper */
/** @var ViewModelRegistry $viewModels */

$walletConfig = $viewModels->require(WalletConfig::class);
$code = $escaper->escapeHtmlAttr($walletConfig->getMethodCode());
?>
<div class="<?= /* @noEscape */ $code ?>">
    <?php if ($walletConfig->isEnabled()): ?>
        <div x-data="<?= /* @noEscape */ $code ?>PaymentForm" x-init="initForm">
            <p x-show="isLoading" x-cloak class="text-secondary text-sm">
                <?= $escaper->escapeHtml(__('Loading payment options...')) ?>
            </p>

            <p x-show="isUnavailable" x-cloak class="message warning">
                <?= $escaper->escapeHtml(
                    __('Apple Pay and Google Pay are not available on this device or browser.')
                    . ' ' . __('Please choose another payment method.')
                ) ?>
            </p>

            <p x-show="showTermsNotice" x-cloak class="text-secondary text-sm">
                <?= $escaper->escapeHtml(__('Please accept the %1 to complete payment.', __('Terms and Conditions'))) ?>
            </p>

            <div x-show="showButtons"
                 x-cloak
                 class="authnetcim-wallet-buttons"
                 :class="getButtonsClass"
                 x-ref="buttons"
                 wire:ignore
            ></div>
        </div>
    <?php endif; ?>
</div>
